{
  "name": "i18nexus",
  "version": "4.0.1",
  "description": "Type-safe React i18n toolkit with intelligent automation and SSR support",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/utils/server.d.ts",
      "import": "./dist/utils/server.js",
      "default": "./dist/utils/server.js"
    },
    "./devtools": {
      "types": "./dist/components/I18NexusDevtools.d.ts",
      "import": "./dist/components/I18NexusDevtools.js",
      "default": "./dist/components/I18NexusDevtools.js"
    }
  },
  "keywords": [
    "react",
    "i18n",
    "internationalization",
    "translation",
    "cookie",
    "google-sheets",
    "typescript",
    "babel",
    "ast"
  ],
  "author": "manNomi <hanmw110@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manNomi/i18nexus.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/manNomi/i18nexus/issues"
  },
  "homepage": "https://github.com/manNomi/i18nexus/tree/main/packages/core#readme",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
