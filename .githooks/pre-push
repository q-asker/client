#!/bin/sh
# 포맷·린트 검증 — 위반 시 push 차단
# rebase, merge, cherry-pick 등으로 pre-commit을 우회한 커밋 방지용 안전망
echo "push 전 포맷 검증 중 (npx prettier --check .)..."
npx prettier --check . 2>/dev/null
if [ $? -ne 0 ]; then
  echo ""
  echo "포맷 위반이 발견되었습니다."
  echo "npx prettier --write . 를 실행한 뒤 다시 push하세요."
  exit 1
fi

echo "push 전 린트 검증 중 (npm run lint)..."
npm run lint --silent
if [ $? -ne 0 ]; then
  echo ""
  echo "린트 에러가 발견되었습니다."
  echo "npx eslint . --fix 로 자동 수정하거나 직접 고친 뒤 다시 push하세요."
  exit 1
fi
